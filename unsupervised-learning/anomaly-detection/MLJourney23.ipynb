          "metadata": {}
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "#Step 7 — Train Isolation Forest\n",
        "model = IsolationForest(\n",
        "    contamination=0.05,\n",
        "    random_state=42\n",
        ")\n",
        "model.fit(X_with_anomalies)"
      ],
