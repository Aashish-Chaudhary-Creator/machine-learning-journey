      "source": [
        "Chapter 23 — Anomaly Detection"
      ],
      "metadata": {
        "id": "BA58rA-Eu4a8"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "#Step 1 — Import Libraries\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "from sklearn.datasets import make_blobs\n",
        "from sklearn.ensemble import IsolationForest"
      ],
      "metadata": {
        "id": "AUiHFWHVu_Vv"
      },
      "execution_count": 1,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "#Step 2 — Generate Normal Data\n",
        "\n",
        "X, _ = make_blobs(\n",
        "    n_samples=300,\n",
        "    centers=1,\n",
        "    cluster_std=1.0,\n",
        "    random_state=42\n",
        ")\n",
        "print(\"Dataset shape:\", X.shape)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "wwgIbIt8vFW0",
        "outputId": "15cb6cf0-0d4e-4f33-bf52-4f843ef5f94a"
      },
      "execution_count": 2,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Dataset shape: (300, 2)\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "#Step 3 — Visualize Normal Data\n",
        "plt.figure(figsize=(8, 6))\n",
        "plt.scatter(\n",
        "    X[:, 0],\n",
        "    X[:, 1],\n",
        "    s=40\n",
        ")\n",
        "plt.xlabel(\"Feature 1\")\n",
        "plt.ylabel(\"Feature 2\")\n",
        "plt.title(\"Normal Data\")\n",
        "plt.show()"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 564
        },
        "id": "YBIJ5dMvvM8n",
        "outputId": "60a3f56c-84ac-4d74-95c7-e2883353b411"
      },
      "execution_count": 3,
      "outputs": [
        {
          "output_type": "display_data",
          "data": {
            "text/plain": [
              "<Figure size 800x600 with 1 Axes>"
            ],
            "image/png": "\n"
          },
          "metadata": {}
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "#Step 4 — Create Artificial Anomalies\n",
        "anomalies = np.array([\n",
        "    [8, 8],\n",
        "    [9, 7],\n",
        "    [8, 9],\n",
        "    [-8, -7],\n",
        "    [-9, -8],\n",
        "    [7, -8],\n",
        "    [-8, 7],\n",
        "    [10, 0],\n",
        "    [0, 10],\n",
        "    [-10, 0]\n",
        "])\n",
        "print(\"Number of anomalies:\", len(anomalies))"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "XPexqZxPvSOk",
        "outputId": "9f619073-b7a1-4bbe-a2f0-a90078c59337"
      },
      "execution_count": 4,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Number of anomalies: 10\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "#Step 5 — Combine Normal Data and Anomalies\n",
        "X_with_anomalies = np.vstack([X, anomalies])\n",
        "print(\"Original data:\", X.shape)\n",
        "print(\"Final data:\", X_with_anomalies.shape)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "_GCfJezNvYqp",
        "outputId": "85d1b9cb-c538-4a11-a9c9-7bdaa1e945b8"
      },
      "execution_count": 5,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Original data: (300, 2)\n",
            "Final data: (310, 2)\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "#Step 6 — Visualize the Complete Dataset\n",
        "plt.figure(figsize=(8, 6))\n",
        "plt.scatter(\n",
        "    X_with_anomalies[:, 0],\n",
        "    X_with_anomalies[:, 1],\n",
        "    s=40\n",
        ")\n",
        "plt.xlabel(\"Feature 1\")\n",
        "plt.ylabel(\"Feature 2\")\n",
        "plt.title(\"Dataset with Artificial Anomalies\")\n",
        "plt.show()"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 564
        },
        "id": "luoBk1FJviEm",
